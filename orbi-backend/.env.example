NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/orbi
CORS_ORIGIN=*

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-32-plus-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-random-secret
HASH_SECRET=replace-with-a-32-plus-character-random-secret-for-deterministic-hashing
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
OTP_EXPIRES_IN_MINUTES=10
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
